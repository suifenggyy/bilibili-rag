# OpenAI Compatible API (Alibaba Cloud DashScope)
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Model Config
LLM_MODEL=qwen3-max
EMBEDDING_MODEL=text-embedding-v4

# DashScope ASR
ASR_BACKEND=whisper
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
ASR_MODEL=paraformer-v2
# 多模型 fallback：逗号分隔，第一个失败/欠费时自动尝试下一个
# ASR_MODEL=paraformer-v2,paraformer-v1
ASR_TIMEOUT=600
ASR_MODEL_LOCAL=paraformer-realtime-v2
# DashScope 并发请求数（同时处理多少个视频的 ASR 转写），默认 2
ASR_CONCURRENCY=2
ASR_INPUT_FORMAT=pcm

# Ollama 本地 ASR（Whisper）
# 需先安装 Ollama 并拉取模型：ollama pull whisper
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ASR_MODEL=whisper
OLLAMA_ASR_LANGUAGE=zh

# 文本后处理 / 正文总结模型
# backend=ollama      -> 调用 Ollama /api/generate（TEXT_MODEL_BASE_URL + TEXT_MODEL_NAME）
# backend=proxy       -> 调用 OpenAI 兼容 /v1/chat/completions（TEXT_MODEL_BASE_URL + TEXT_MODEL_NAME）
# backend=localopenai -> 调用本地 OpenAI 兼容接口（LOCAL_OPENAI_BASE_URL + LOCAL_OPENAI_MODEL）
TEXT_MODEL_BACKEND=ollama
TEXT_MODEL_BASE_URL=http://localhost:11434
TEXT_MODEL_NAME=gemma4:e2b
TEXT_MODEL_TIMEOUT=300
TEXT_MODEL_CORRECTION_PROMPT=下面是一段语音转换生成的文本，请结合后续提供的文章标题判断文本主题方向，据此修正识别错误的字词，优化语句通顺度，规范格式，补充合适标点符号并划分合理段落；最终仅输出纠错并格式化后的文本，不添加任何额外信息。
TEXT_MODEL_SUMMARY_PROMPT=请严格依据下方原始正文文本开展专业化精炼汇总与核心信息萃取工作，全程恪守信息完整留存、内容客观还原、逻辑条理规整、表述专业规范四大核心原则，不得擅自删减核心要件、篡改原文语义逻辑、新增主观臆断内容或弱化关键实操要点。全面精准提炼文本核心主旨、核心业务内容与核心逻辑脉络，系统性完整留存原文所有不可缺失关键信息，全覆盖保留各类实操类、数据类、专属类核心内容，具体包含且不限于全流程操作规范、标准化执行细则、分步安装部署流程、核心实操代码片段、专属访问链接与网络地址、官方专有名称及专属代号、核心业务运行参数、关键时间节点与精准数值指标、环节衔接核心逻辑、注意警示事项与禁忌操作要求、配套备注补充说明等全部核心刚需内容。完成内容精炼总结后，结合文本核心主题、业务领域、核心用途、关键核心关键词，提炼生成精准贴合、分类清晰、适配归档检索与快速识别使用的标准化专属标签，整体输出内容结构规整、层级分明、专业严谨、一目了然，适配正式归档、工作查阅、业务对接、资料留存等专业办公使用场景。\n\n请严格按 YAML 输出，不要添加额外说明，格式如下：\nsummary: |\n  一段精炼总结\nkey_points:\n  - 要点1\n  - 要点2\ntags:\n  - 标签1\n  - 标签2

# 本地 OpenAI 兼容接口（TEXT_MODEL_BACKEND=localopenai 时生效）
# 适用于 LM Studio / Jan / LocalAI / ollama openai-compat 等提供 /v1/chat/completions 的本地服务
LOCAL_OPENAI_BASE_URL=http://localhost:4141
# LOCAL_OPENAI_MODEL 为空时回退到 TEXT_MODEL_NAME
LOCAL_OPENAI_MODEL=

# 本地 openai-whisper ASR
# 需先安装依赖并选择模型：tiny | base | small | medium | large | turbo
WHISPER_MODEL=small
WHISPER_LANGUAGE=zh

# ==================== 抖音导出配置 ====================
# 抖音不提供扫码 API，需手动从浏览器复制 Cookie：
#   1. Chrome 打开 https://www.douyin.com 并登录
#   2. F12 → Application → Cookies → douyin.com
#   3. 复制全部字段，拼接为 "key1=val1; key2=val2; ..." 格式
DOUYIN_COOKIE=

# Evil0ctal/Douyin_TikTok_Download_API 已作为 git submodule 集成，无需单独部署
# （原 DOUYIN_EVIL0CTAL_URL 配置已废弃）

# ==================== 小宇宙配置 ====================
# 通过 scripts/export_xiaoyuzhou_to_md.py --login 登录后自动生成
# 也可手动填写（从 .xiaoyuzhou_session.json 中复制）
XIAOYUZHOU_ACCESS_TOKEN=
XIAOYUZHOU_REFRESH_TOKEN=

# ==================== YouTube 配置 ====================
# 多个来源用逗号分隔，脚本启动时可通过 YOUTUBE_SOURCES 读取
YOUTUBE_SOURCES=
# YouTube Cookie 文本（支持两种格式，直接粘贴无需文件）
# 格式一：浏览器开发者工具 → Application → Cookies → 复制所有 cookie 的 name=value; 字符串
# 格式二：安装 "Get cookies.txt LOCALLY" 插件 → 导出 Netscape 格式文本粘贴
YOUTUBE_COOKIES=
# 或者指定 Cookie 文件路径（二选一，YOUTUBE_COOKIES 优先）
YOUTUBE_COOKIE_FILE=
# 只导出该日期之后发布的视频（YYYY-MM-DD，留空则不限制）
YOUTUBE_AFTER_DATE=
# 每个来源最多导出 N 个视频（0=不限制）
YOUTUBE_LIMIT=0

# 抓取工作目录：原视频 / 音频 / ASR 原文 / 纠错结果
CONTENT_WORKSPACE_ROOT=~/.bilibili-rag
CONTENT_WORKSPACE_MAX_SIZE_BYTES=1073741824
CONTENT_WORKSPACE_RETENTION_DAYS=3

# 最终 Markdown 输出目录（已废弃，仅用于 legacy import 迁移历史文件，新文件写入 OBSIDIAN_VAULT_ROOT/inbox）
# COLLECTION_OUTPUT_DIR=... # deprecated, legacy import only
COLLECTION_OUTPUT_DIR=/Users/gongyongyue/FangcloudV2/personal_space.localized/同步空间/个人资料/Obsidian/jarvis/collection

# ==================== Obsidian Vault 与知识库流水线配置 ====================
# Vault 根目录（所有路径均相对于此目录）
OBSIDIAN_VAULT_ROOT=/Users/gongyongyue/FangcloudV2/personal_space.localized/同步空间/个人资料/Obsidian/jarvis
# inbox 子目录（导出脚本写入目标，流水线消费此目录）
OBSIDIAN_INBOX_DIR=inbox
# 知识库归档目录
OBSIDIAN_KNOWLEDGE_DIR=knowledge
# 日报目录
OBSIDIAN_DAILY_DIR=daily
# 元数据目录（category-map.json、处理日志）
OBSIDIAN_META_DIR=_meta
# Obsidian Local REST API（可选，https://github.com/coddingtonbear/obsidian-local-rest-api）
OBSIDIAN_LOCAL_REST_URL=http://127.0.0.1:27124
OBSIDIAN_LOCAL_REST_API_KEY=
# 写入后端：obsidian_api（默认）或 filesystem
OBSIDIAN_WRITE_BACKEND=obsidian_api

# Tavily API Key（用于日报外部信号搜索，https://tavily.com/）
TAVILY_API_KEY=

# 知识库分类超时（秒）
KNOWLEDGE_CLASSIFICATION_TIMEOUT=120

# ==================== Instapaper 配置 ====================
# 申请 API Key：https://www.instapaper.com/main/request_oauth_consumer_token
INSTAPAPER_CONSUMER_KEY=
INSTAPAPER_CONSUMER_SECRET=

# 登录凭据（用于 xAuth 换取 access token）
INSTAPAPER_EMAIL=
INSTAPAPER_PASSWORD=

# App Config
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/bilibili_rag.db

# ChromaDB
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
